# Canonical site URL, used for sitemap.xml, robots.txt and hreflang tags
NEXT_PUBLIC_APP_URL=https://calminvestments.com

# Resend (https://resend.com) - required for the contact form
RESEND_API_KEY=re_xxxxxxxxxxxx
# Where contact form submissions are delivered
CONTACT_TO_EMAIL=j.vanderhelm@calminvestments.com
# Verified sender (domain must be verified in Resend)
CONTACT_FROM_EMAIL=Calm Investments <website@calminvestments.com>

# Google Analytics 4 measurement ID (e.g. G-XXXXXXXXXX).
# Leave empty to disable analytics entirely: without it no cookie banner
# is shown and no GA script ever loads. With it, GA only loads after the
# visitor accepts the cookie banner.
NEXT_PUBLIC_GA_ID=

# Cloudflare Turnstile (https://dash.cloudflare.com -> Turnstile) - spam protection
# Leave empty in local dev to skip captcha verification
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
